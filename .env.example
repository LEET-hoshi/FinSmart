POSTGRES_DB=finsmart
POSTGRES_USER=finsmart
POSTGRES_PASSWORD=finsmart

JWT_SECRET=local-dev-secret-change-me-0123456789abcdef

DB_PORT=5432
API_PORT=8080

# Local MVP testing account. Disable this on a public deployment if a shared
# demo profile is not wanted.
DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT_EMAIL=demo@finsmart.local
DEMO_ACCOUNT_PASSWORD=demo12345

# Disabled by default. Set only a vetted provider endpoint and inject the key via local/CI secrets.
LLM_ENABLED=false
# LLM_ENDPOINT=https://provider.example/v1/finsmart/recommendation
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=5
